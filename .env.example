# Copiar a .env. Generar una clave propia; no publicar el archivo .env.
API_KEY=replace-with-a-random-local-key
CORE_URL=https://dummyjson.com/users/{id}
PRODUCTS_URL=https://dummyjson.com/carts/user/{id}?limit=0
FX_URL=https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR,GBP
# Opcional: habilitar una prueba real de degradación. Dejar vacío para flujo normal.
UNSTABLE_URL=
# UNSTABLE_URL=https://httpbin.org/status/500
# UNSTABLE_URL=https://httpbin.org/delay/6
UPSTREAM_TIMEOUT_SECONDS=1.5
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_BACKOFF_SECONDS=0.1
FX_TTL_SECONDS=3600
